OPENAI_AGENTS_DISABLE_TRACING=1

YC_OAUTH_CLIENT_ID=replace_with_oauth_client_id
YC_OAUTH_CLIENT_SECRET=replace_with_oauth_client_secret
YC_OAUTH_REDIRECT_URI=https://example.com/yc/oauth/callback
YC_OAUTH_SCOPES=openid profile email

# Generate with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode("ascii"))'
YC_TOKEN_ENCRYPTION_KEY=replace_with_generated_fernet_key
YC_OAUTH_CALLBACK_HOST=0.0.0.0
YC_OAUTH_CALLBACK_PORT=8080
YC_OAUTH_DB_PATH=/data/refresh_tokens.db
OAUTH_GATEWAY_SHARED_SECRET=replace_with_long_random_shared_secret
